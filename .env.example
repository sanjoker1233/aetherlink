# Copiez ce fichier en .env (NON versionne) et renseignez les valeurs.
# docker compose up lit ces variables pour configurer Caddy + TLS (HTTPS).

# Domaine public (A record vers ce serveur). Caddy delivre le certificat
# Let's Encrypt automatiquement pour ce domaine.
DOMAIN=app.example.com

# Email ACME (obligatoire pour Let's Encrypt).
CADDY_EMAIL=admin@example.com

# Cle de signature JWT (>= 32 octets). A GENERER, jamais commiter.
# Generation : openssl rand -base64 48
JWT_SECRET=

# Origine exacte du frontend (meme domaine que DOMAIN). Pas de wildcard.
ALLOWED_ORIGINS=https://app.example.com

# URL publique HTTPS du backend vue par le navigateur (meme domaine que DOMAIN).
# Inlinee dans le bundle Next.js, donc rebuild si changée.
NEXT_PUBLIC_API_URL=https://app.example.com
